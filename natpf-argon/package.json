{
  "name": "natpf-simulator-tennis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/download-assets.mjs && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "predev": "[ -d node_modules/.bin ] || bun install || npm install",
    "prebuild": "[ -d node_modules/.bin ] || bun install || npm install",
    "prelint": "[ -d node_modules/.bin ] || bun install || npm install",
    "test": "node --import ./test/register.mjs --test test/*.test.mjs",
    "dev:https": "node scripts/dev-https.mjs",
    "assets": "node scripts/download-assets.mjs",
    "assets:check": "node scripts/download-assets.mjs --check",
    "lan": "node lan/server.mjs",
    "test:e2e-lan": "node test/e2e/lan-e2e.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@mediapipe/hands": "0.4.1675469240",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  },
  "description": "NATPF Simulator: tennis 3D nell'arena delle Nitto ATP Finals, smartphone o webcam come racchetta, 1v1, prima e terza persona"
}
