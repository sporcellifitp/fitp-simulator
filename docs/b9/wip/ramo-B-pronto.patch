+/* ---------- stato «pronto» dei giocatori nel 1v1 (natpf_ready.js, B9): stesso schermo e sfida un amico ----------
+   Distintivo con icona e parola, mai solo il colore: in attesa (cerchio vuoto, grigio) · si prepara (anello che gira,
+   ambra) · pronto (✓, verde pieno con testo scuro) · problema (!, rosso). Misure con cqh/cqw: su un ledwall restano
+   leggibili */
+.ready-badge { display: inline-flex; align-items: center; gap: 0.45em; padding: 0.3em 0.85em 0.3em 0.4em; border-radius: var(--r-pill); border: 2px solid var(--line-strong); background: rgba(255, 255, 255, 0.04); color: var(--text-2); font: 800 italic clamp(14px, min(2.2cqh, 1.3cqw), 28px)/1 var(--font-display); letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
+.ready-badge b { font: inherit; }
+.ready-ico { flex: none; display: grid; place-items: center; box-sizing: border-box; width: 1.3em; height: 1.3em; border-radius: 50%; border: 2px solid currentColor; font-style: normal; }
+.is-off .ready-ico { border-style: dashed; opacity: 0.8; }
+.is-prep .ready-badge { color: var(--warn); border-color: rgba(255, 198, 64, 0.6); background: rgba(255, 198, 64, 0.12); }
+.is-prep .ready-ico { border-color: rgba(255, 198, 64, 0.28); border-top-color: var(--warn); border-width: 3px; animation: ready-spin 0.9s linear infinite; }
+.is-ready .ready-badge { color: var(--ink-900); border-color: var(--ok); background: var(--ok); animation: ready-pop 0.28s var(--ease) both; }
+.is-ready .ready-ico { border-color: var(--ink-900); background: var(--ink-900); color: var(--ok); }
+.is-ready .ready-ico::after { content: "✓"; font: 900 0.8em/1 var(--font-text); }
+.is-ko .ready-badge { color: #fff; border-color: var(--bad); background: var(--bad); }
+.is-ko .ready-ico { border-color: #fff; background: #fff; color: var(--bad); }
+.is-ko .ready-ico::after { content: "!"; font: 900 0.8em/1 var(--font-text); }
+@keyframes ready-spin { to { transform: rotate(360deg); } }
+@keyframes ready-pop { 0% { transform: scale(0.8); } 60% { transform: scale(1.12); } 100% { transform: none; } }
+/* scheda compatta (pagina «Partita» dello stesso schermo, pannello del Player 2 e barra dell'invito della sfida) */
+.ready-slot { --who: var(--ball); display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "who badge" "detail badge"; align-items: center; gap: 4px 12px; padding: 10px 14px 10px 20px; border-radius: var(--r-m); border: 2px solid var(--line-strong); background: var(--panel); box-shadow: inset 6px 0 0 var(--who); color: var(--text); text-align: left; transition: border-color var(--t-med), background var(--t-med); }
+.ready-slot[data-p="p2"] { --who: var(--pink); }
+.ready-slot .ready-who { grid-area: who; display: flex; align-items: baseline; gap: 8px; min-width: 0; }
+.ready-slot .ready-who b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 800 italic clamp(18px, 2.8cqh, 32px)/1 var(--font-display); text-transform: uppercase; color: var(--who); }
+.ready-slot .ready-you { font: 600 12px/1 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3); }
+.ready-slot .ready-you.hidden { display: none; }
+.ready-slot .ready-badge { grid-area: badge; }
+.ready-slot .ready-detail { grid-area: detail; min-width: 0; font: 500 clamp(13px, 1.9cqh, 20px)/1.3 var(--font-text); color: var(--text-2); }
+.ready-slot .ready-detail:empty { display: none; }
+.ready-slot.is-off { border-style: dashed; }
+.ready-slot.is-prep { border-color: rgba(255, 198, 64, 0.6); }
+.ready-slot.is-ready { border-color: var(--ok); background: linear-gradient(rgba(54, 224, 122, 0.14), rgba(54, 224, 122, 0.14)), var(--panel); }
+.ready-slot.is-ko { border-color: var(--bad); }
+.ready-slot.compact .ready-badge { font-size: clamp(12px, min(1.9cqh, 1.15cqw), 22px); }
+/* pulsante «pronto» premuto (sfida un amico, Player 2): verde pieno, non è più un interruttore (si annulla con «Annulla»);
+   «Gioca» che non si può ancora premere: grigio neutro, non giallo spento */
+.natpf-sheet .lobby-primary.is-ready, .natpf-lobby .lobby-primary.is-ready { background: var(--ok); color: var(--ink-900); box-shadow: 0 8px 22px rgba(54, 224, 122, 0.3); cursor: default; }
+.natpf-sheet .lobby-primary.is-ready:hover, .natpf-lobby .lobby-primary.is-ready:hover { background: var(--ok); transform: none; }
