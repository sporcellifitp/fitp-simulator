 natpf-tennis/natpf-ui.css | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/natpf-tennis/natpf-ui.css b/natpf-tennis/natpf-ui.css
index ea6292e..2445569 100644
--- a/natpf-tennis/natpf-ui.css
+++ b/natpf-tennis/natpf-ui.css
@@ -1109,6 +1109,19 @@ body.natpf-split #opponent-presence-pill { display: none !important; }
   #title-modal .split-player { grid-template-columns: 110px 1fr; }
   #title-modal .split-qr .natpf-qr { width: 110px; height: 110px; }
 }
+/* area stretta ma non da telefono (per esempio un ledwall 720×720): le due schede affiancate e compatte, il QR sopra lo
+   stato, così i due QR stanno nell'area senza scorrere e la barra dell'avvio non ne copre nessuno. Prima le schede una
+   sotto l'altra mettevano il QR del Player 2 sotto la barra fissa (revisione B9 del 06/11) */
+@container natpf (min-width: 600px) and (max-width: 860px) {
+  #title-modal .split-setup { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
