   // ogni swing che parte (di qualunque colpo) trova il personaggio a terra: il saltello alza anche la racchetta, e
   // all'impatto la racchetta deve stare dov'era prima
   if (T.swingActive && !s.any){ s.hit = false; s.hop = 0; }
