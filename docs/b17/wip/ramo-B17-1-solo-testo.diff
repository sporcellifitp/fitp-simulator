+      const c = lim.byCard[id] ??= { n: 0, ok: 0, read: {} }, d = describe(r, id, hand);
+      c.n++; if (!why.length) c.ok++; c.read[d] = (c.read[d] || 0) + 1;
+      continue;
+    }
+    n++;
+    if (why.length) bad.push(`seme ${seed} ${id} ${hand} cal=${cal} ×${rate}: ${why.join('; ')}`);
+  }
+  return { n, bad, lim, ids };
+}
